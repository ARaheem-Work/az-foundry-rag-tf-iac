# Terraform working directories
**/.terraform/*

# Terraform state files
*.tfstate
*.tfstate.*

# Terraform plan files
*.tfplan

# Terraform variable files (often contain secrets)
*.tfvars
*.tfvars.json
!*.tfvars.example

# Terraform override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Terraform crash logs
crash.log
crash.*.log

# CLI config and credentials
.terraformrc
terraform.rc

# Local environment files
.env
.env.*
!.env.example

# Editor and OS artifacts
.vscode/
.idea/
*.swp
*.swo
Thumbs.db
.DS_Store
